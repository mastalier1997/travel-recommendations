# Set MOCK=1 to make every /api route return fixture data instead of calling out.
# UI tracks (B, G, H) should be able to run the whole app with only this line set.
MOCK=1

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Geocoding. Nominatim needs no key but requires a real contact address in the UA header.
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=you@example.com
MAPTILER_KEY=

# Map tiles (client-side, restrict by HTTP referrer in the MapTiler dashboard)
NEXT_PUBLIC_MAPTILER_KEY=

# Routing. Swap for a self-hosted container before real users — the demo server
# forbids production use and caps /trip waypoints.
OSRM_URL=https://router.project-osrm.org
